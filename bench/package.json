{
  "name": "@valibot/bench",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "vitest bench --run",
    "bench:baseline": "vitest bench --run --outputJson=baseline.json",
    "bench:compare": "vitest bench --run --compare=baseline.json",
    "lint": "eslint \"src/**/*.ts*\" && tsc --noEmit",
    "format": "prettier --write ./src",
    "format.check": "prettier --check ./src"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.2.4",
    "vitest": "4.1.8"
  }
}
